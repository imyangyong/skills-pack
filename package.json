{
  "name": "@imyangyong/skills",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "description": "skills collection",
  "license": "MIT",
  "keywords": [
    "agent",
    "skills",
    "skills-npm",
    "ai",
    "claude",
    "opencode",
    "cursor"
  ],
  "files": [
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "sync": "tsx scripts/sync-global.ts",
    "lint": "pnpm run gen --check && eslint",
    "release": "bumpp",
    "test": "tsx scripts/test.ts",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks"
  },
  "scripts-info": {
    "gen": "Sync package.json `skills` field and README table from meta.ts",
    "sync": "Interactively symlink selected skills to ~/.agents/skills and ~/.claude/skills",
    "lint": "Check generated files are in sync and code style",
    "release": "Bump version and publish a release",
    "test": "Install the pack into a temp project and verify every skill lands",
    "typecheck": "Check types",
    "prepare": "Set up git hooks"
  },
  "skills": [
    {
      "source": "imyangyong/skills",
      "skills": [
        "code-review",
        "yong-coding-preferences",
        "decode-terms",
        "optimize-code"
      ]
    },
    {
      "source": "larksuite/cli",
      "skills": [
        "lark-apps",
        "lark-base",
        "lark-calendar",
        "lark-contact",
        "lark-doc",
        "lark-drive",
        "lark-im",
        "lark-meeting",
        "lark-okr",
        "lark-openapi-explorer",
        "lark-shared",
        "lark-task",
        "lark-whiteboard",
        "lark-wiki",
        "lark-workflow-meeting-summary"
      ]
    },
    {
      "source": "mattpocock/skills",
      "skills": [
        "setup-matt-pocock-skills",
        "grill-me",
        "grilling",
        "grill-with-docs",
        "to-spec",
        "to-tickets",
        "implement-spec",
        "implement",
        "handoff",
        "to-questionnaire",
        "writing-for-agents",
        "wait-what",
        "teach",
        "codebase-design",
        "research",
        "retro",
        "tdd",
        "diagnosing-bugs",
        "domain-modeling",
        "wayfinder"
      ]
    },
    "shadcn/improve",
    "kucherenko/jscpd/skills/dry-refactoring",
    "AminBlg/SimpleEnglish",
    "cursor/plugins/pstack/skills/unslop",
    "ayghri/i-have-adhd",
    {
      "source": "antfu/skills",
      "skills": [
        "antfu",
        "antfu-create-pr",
        "antfu-issue-triage"
      ]
    },
    {
      "source": "vuejs-ai/skills",
      "skills": [
        "vue-best-practices",
        "vue-router-best-practices",
        "vue-pinia-best-practices",
        "vue-testing-best-practices",
        "vue-debug-guides",
        "create-adaptable-composable"
      ]
    },
    {
      "source": "onmax/nuxt-skills",
      "skills": [
        "nuxt-modules"
      ]
    },
    "anthropics/skills/skills/frontend-design",
    "vercel-labs/agent-browser"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@clack/prompts": "catalog:",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "nano-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "yaml": "catalog:cli"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
